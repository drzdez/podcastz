{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "podcastz",
  "version": "0.1.0",
  "identifier": "io.github.drzdez.podcastz",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "podcastz",
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "mainBinaryName": "podcastz-app",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVENUM5MEYxRjExQ0Y2QTUKUldTbDloeng4WkJjWFdZcXR5Q2tTbFZGQUdFVnZiRjZ3dDdoRFFaZ2pCVjAzd05WNjc1ZXRzUWoK",
      "endpoints": [
        "https://github.com/drzdez/podcastz/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
