{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "podcastz",
  "version": "0.1.1",
  "identifier": "io.github.drzdez.podcastz",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "podcastz",
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "drzdez",
    "homepage": "https://github.com/drzdez/podcastz",
    "license": "MIT",
    "shortDescription": "Learn by listening to podcasts you prepare yourself",
    "windows": {
      "wix": {
        "template": "windows/main.wxs"
      },
      "nsis": {
        "installMode": "perMachine"
      }
    }
  },
  "mainBinaryName": "podcastz-app",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIyOUE4MDg5MjJCOTI5ODIKUldTQ0tia2lpWUNhSXVtRjJIZW9HMGdvRk52NkxIN1JpMXprWGdKWldiN1FkeXFPSkw5RDRuOXgK",
      "endpoints": [
        "https://github.com/drzdez/podcastz/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
